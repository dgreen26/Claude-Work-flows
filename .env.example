# OpenRouter — routes to Kling, Veo, and other video generation models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ElevenLabs — text-to-speech voiceover (stub until key is ready)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Output settings
OUTPUT_CODEC=h264
OUTPUT_CONTAINER=mp4
OUTPUT_RESOLUTION=1080x1920
OUTPUT_FPS=30

# ── Meridian Supply Chain Risk Intelligence ─────────────────────────────────

# LLM (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# LiteLLM model routing
LITELLM_MODEL_SYNTHESIS=anthropic/claude-sonnet-4-6
LITELLM_MODEL_CLASSIFICATION=anthropic/claude-haiku-4-5-20251001

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian
REDIS_URL=redis://localhost:6379/0

# Embedding
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# External data APIs (GDELT and EDGAR are free with no key required)
NEWSAPI_KEY=

# Storage (optional S3 for raw file archiving)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Eval thresholds (CI gate)
RAGAS_EVAL_THRESHOLD_FAITHFULNESS=0.75
RAGAS_EVAL_THRESHOLD_RELEVANCY=0.70
